[user]
	name = Jan Sroka
	email = github@jansroka.com
	signingkey = 08ECE799

[credential]
	helper = osxkeychain
	helper =
	helper = /usr/local/share/gcm-core/git-credential-manager

[core]
	excludesfile = /Users/jan/.gitignore_global

[commit]
	template = /Users/jan/.stCommitMsg
	gpgsign = true

[http]
	postBuffer = 524288000

[color]

	# Use colors in Git commands that are capable of colored output when
	# outputting to the terminal. (This is the default setting in Git ≥ 1.8.4.)
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold # line info
	old = red # deletions
	new = green # additions

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	rebase = true

[diff]
	colorMoved = zebra

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[gpg]
	program = gpg
[tag]
	gpgSign = true
[push]
	autoSetupRemote = true
[status]
	showstash = true
[credential "https://dev.azure.com"]
	useHttpPath = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

# Per-directory identity overrides.
# MUST stay at the end of this file: git applies config in the order it reads it,
# so an include only wins over the [user] block above if it comes after it.
# The trailing slash on the gitdir pattern is required — it makes the pattern
# match that directory and everything beneath it.
[includeIf "gitdir:~/Code/Daito/"]
	path = ~/.gitconfig-daito
