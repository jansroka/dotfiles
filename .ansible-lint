---
# Ansible-lint configuration

# Warn about deprecated Ansible features
warn_list:
  - experimental

# Rules skipped intentionally for a personal dotfiles playbook:
#   no-changed-when  - maintenance shell tasks are always run by design
#   no-free-form     - osx_defaults free-form style is a project convention
#   var-naming       - default_gems / brew_packages use short names intentionally
skip_list:
  - no-changed-when
  - no-free-form
  - var-naming[no-role-prefix]
  - yaml[line-length]  # line-length is already warning-only in .yamllint

# Exclude certain paths from linting
exclude_paths:
  - .git
  - .venv
  - venv
  - roles/symlinks/files/

use_default_rules: true
